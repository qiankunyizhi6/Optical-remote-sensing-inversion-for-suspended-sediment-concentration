//边缘otsu算法进行水体提取
function edgecalcWater(imageCollection, kwargs, geom) {
// 强制将输入参数imageCollection转换为ee.ImageCollection类型，用于后续处理
imageCollection = ee.ImageCollection(imageCollection);
// 获取影像集合中使用的波段名称列表，用于后续操作
var bandList = ee.Image(imageCollection.first()).bandNames();
  // 定义关键字的默认参数
  var kwargDefaults = {
    'initialThreshold':-0.2,  // 初始阈值
    'reductionScale': 20,  // 缩减比例
    //'smoothing': 200,
    'bandName': bandList.get(0),  // 波段名称
    'connectedPixels': 100,  // 连通像素数阈值
    'edgeLength': 20,  // 边缘长度
    'smoothEdges': 300,  // 平滑边缘距离
    'cannyThreshold': 0.99,  // Canny边缘检测阈值
    'cannySigma': 0.7,  // Canny边缘检测Sigma值
    'cannyLt': 0.05,
    'maxBuckets': 255,  // 最大分桶数
    'minBucketWidth': 0.001,  // 最小桶宽度
    'maxRaw': 1e6,  // 最大原始值
    'invert': false,  // 是否反转
    'verbose': false  // 是否输出详细信息
  };
  // 获取关键字的键值列表
  var kwargKeys = [];
  for (var key in kwargDefaults) {
    kwargKeys.push(key);
  }
  var params;
  var i, k, v;
  // 遍历关键字并构建ee.Dictionary
  // 如果输入中定义了关键字，则使用输入值；否则使用默认值
  params = ee.Dictionary(kwargs);
  for (i = 0; i < kwargKeys.length; i++) {
    k = kwargKeys[i];
    v = kwargDefaults[k];
    params = ee.Dictionary(
      ee.Algorithms.If(params.contains(k), params, params.set(k, v))
    );
  }
  // 所有方法的共同参数
  var initialThreshold = ee.Number(params.get('initialThreshold')),  // 初始阈值
      reductionScale   = ee.Number(params.get('reductionScale')),  // 缩减比例
      //smoothing        = ee.Number(params.get('smoothing')),
      bandName         = ee.String(params.get('bandName')),  // 波段名称
      connectedPixels  = ee.Number(params.get('connectedPixels')),  // 连通像素数阈值
      edgeLength       = ee.Number(params.get('edgeLength')),  // 边缘长度
      smoothEdges      = ee.Number(params.get('smoothEdges')),  // 平滑边缘距离
      cannyThreshold   = ee.Number(params.get('cannyThreshold')),  // Canny边缘检测阈值
      cannySigma       = ee.Number(params.get('cannySigma')),  // Canny边缘检测Sigma值
      cannyLt          = ee.Number(params.get('cannyLt')),
      maxBuckets       = ee.Number(params.get('maxBuckets')),  // 最大分桶数
      minBucketWidth   = ee.Number(params.get('minBucketWidth')),  // 最小桶宽度
      maxRaw           = ee.Number(params.get('maxRaw')),  // 最大原始值
      invert           = params.get('invert'),  // 是否反转
      verbose          = params.get('verbose').getInfo();  // 是否输出详细信息
      
  var img = imageCollection.select(bandName).mean().clip(geom);
  // 获取图像集合中指定波段的平均值影像，并裁剪到指定几何范围内
  // 获取初始水体
  var binary_Image = img.gt(initialThreshold).rename('binary');
  // 获取Canny边缘
  var canny = ee.Algorithms.CannyEdgeDetector(binary_Image, cannyThreshold, cannySigma);
  // 处理Canny边缘，true为8连通
  var connected = canny.updateMask(canny).lt(cannyLt).connectedPixelCount(connectedPixels, true);
  var edges = connected.gte(edgeLength);
  edges = edges.updateMask(edges);
  var edgeBuffer = edges.focal_max(smoothEdges, 'square', 'meters');
  // 获取Otsu阈值所需的直方图
  var histogram_image = img.updateMask(edgeBuffer);
  print(histogram_image);
  var chart = ui.Chart.image.histogram({
  image: histogram_image,
  region: table1,
  scale: 200,
  minBucketWidth: 300,
  maxPixels:1e13
  }).setOptions({
  width: 400,
  height: 240,
  title: 'Histogram of MNDWI in roi',
  colors: ['#e0440e', '#e6693e', '#ec8f6e', '#f3b49f', '#f6c7b6']
  });
  print(chart);
  // 计算直方图
  var histogram = ee.Dictionary(histogram_image.reduceRegion({
    reducer: ee.Reducer.histogram(maxBuckets, minBucketWidth, maxRaw)
      .combine('mean', null, true).combine('variance', null, true),
    geometry: geom,
    scale: reductionScale,
    maxPixels: 1e13,
    tileScale: 16
  }).get(bandName.cat('_histogram')));

  var threshold = otsu(histogram);
  // 分割影像并屏蔽值为0的部分（非水体）
  var waterImg = ee.Image(ee.Algorithms.If(invert, img.lt(threshold), img.gt(threshold)));
  return waterImg;
}

// Otsu方法计算阈值
function otsu(histogram) {
  var counts = ee.Array(ee.Dictionary(histogram).get('histogram'));
  var means = ee.Array(ee.Dictionary(histogram).get('bucketMeans'));
  var size = means.length().get([0]);
  var total = counts.reduce(ee.Reducer.sum(), [0]).get([0]);
  var sum = means.multiply(counts).reduce(ee.Reducer.sum(), [0]).get([0]);
  var mean = sum.divide(total);
  var indices = ee.List.sequence(1, size);
  var bss = indices.map(function(i) {
    var aCounts = counts.slice(0, 0, i);
    var aCount = aCounts.reduce(ee.Reducer.sum(), [0]).get([0]);
    var aMeans = means.slice(0, 0, i);
    var aMean = aMeans.multiply(aCounts)
      .reduce(ee.Reducer.sum(), [0]).get([0])
      .divide(aCount);
    var bCount = total.subtract(aCount);
    var bMean = sum.subtract(aCount.multiply(aMean)).divide(bCount);
    return aCount.multiply(aMean.subtract(mean).pow(2)).add(
      bCount.multiply(bMean.subtract(mean).pow(2)));
  });
  return means.sort(bss).get([-1]);
}

// 计算水体掩膜
function calWaterMask(image) {
  var MNDWI_S2 = image.select("NDWI");
  var histogram = MNDWI_S2.reduceRegion({
    reducer: ee.Reducer.histogram(),
    geometry: table1,
    scale: 30,
    maxPixels: 1e13,
    tileScale: 8
  });
  var threshold_S2 = otsu(histogram.get("NDWI"));
  var mask = MNDWI_S2.gte(threshold_S2);
  return image.addBands(mask.rename('mask'));
}
